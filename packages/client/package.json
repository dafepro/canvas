{
  "name": "@canvas-physics/client",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./worker": {
      "types": "./dist/simulation/simulation.worker.d.ts",
      "default": "./dist/simulation/simulation.worker.js"
    },
    "./worker-runtime": {
      "types": "./dist/simulation/worker-runtime.d.ts",
      "default": "./dist/simulation/worker-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@canvas-physics/core": "workspace:*",
    "@canvas-physics/protocol": "workspace:*",
    "@dimforge/rapier2d-compat": "^0.20.0",
    "pixi.js": "^8.20.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
