{
  "name": "canvas-physics",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "dev": "pnpm --filter @canvas-physics/demo dev",
    "example:soccer": "pnpm --filter @canvas-physics/example-soccer-lounge dev",
    "example:soccer:server": "pnpm --filter @canvas-physics/example-soccer-lounge server",
    "example:items": "pnpm --filter @canvas-physics/example-item-playground dev",
    "example:items:server": "pnpm --filter @canvas-physics/example-item-playground server",
    "example:rooms": "pnpm --filter @canvas-physics/example-linked-rooms dev",
    "example:rooms:server": "pnpm --filter @canvas-physics/example-linked-rooms server",
    "example:basketball": "pnpm --filter @canvas-physics/example-basketball-arena dev",
    "example:basketball:server": "pnpm --filter @canvas-physics/example-basketball-arena server"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "ts-proto": "^2.12.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
