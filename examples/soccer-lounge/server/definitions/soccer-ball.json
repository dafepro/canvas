{
  "definitionId": "soccer-ball",
  "version": 4,
  "displayName": "Match ball",
  "visual": {
    "spriteId": "soccer.ball.idle",
    "size": { "width": 6, "height": 6 },
    "placeholder": { "shape": "circle", "color": 16250089 },
    "zIndex": 6,
    "variants": {
      "goal": { "color": 16765286 }
    },
    "animations": {
      "hardKick": {
        "frames": [
          "soccer.ball.idle",
          "soccer.ball.impact",
          "soccer.ball.stretch",
          "soccer.ball.settle",
          "soccer.ball.idle"
        ],
        "fps": 18,
        "loop": false
      }
    }
  },
  "body": {
    "mode": "dynamic",
    "mass": 0.45,
    "gravityScale": 0,
    "linearDamping": 0.15,
    "angularDamping": 0.35,
    "canSleep": true
  },
  "colliders": [
    {
      "id": "solid",
      "role": "itemSolid",
      "shape": { "type": "circle", "radius": 3 },
      "restitution": 0.9,
      "friction": 0.2,
      "collisionMask": 12
    },
    {
      "id": "kick",
      "role": "itemSensor",
      "shape": { "type": "circle", "radius": 4.2 }
    }
  ],
  "behaviorType": "soccerBall",
  "defaultConfig": {
    "sensorId": "kick",
    "kickStrength": 1.7,
    "maxImpulse": 24,
    "tangentialStrength": 0.35,
    "maxTangentialImpulse": 5,
    "spinTransfer": 0.8,
    "spinRadius": 3,
    "maxAngularSpeed": 12,
    "cooldownSeconds": 0.2,
    "resetSeconds": 1.5,
    "centre": { "x": 60, "y": 36 },
    "homeGoalTag": "rightGoal",
    "awayGoalTag": "leftGoal"
  },
  "persistence": {
    "transform": true,
    "behaviorState": true,
    "onRoomSleep": "pause"
  },
  "complexity": "simple",
  "configSchema": {
    "type": "object",
    "properties": {
      "sensorId": { "type": "string" },
      "kickStrength": { "type": "number" },
      "maxImpulse": { "type": "number" },
      "tangentialStrength": { "type": "number", "minimum": 0 },
      "maxTangentialImpulse": { "type": "number", "minimum": 0 },
      "spinTransfer": { "type": "number", "minimum": 0 },
      "spinRadius": { "type": "number", "exclusiveMinimum": 0 },
      "maxAngularSpeed": { "type": "number", "minimum": 0 },
      "cooldownSeconds": { "type": "number" },
      "resetSeconds": { "type": "number" },
      "centre": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"],
        "additionalProperties": false
      },
      "homeGoalTag": { "type": "string" },
      "awayGoalTag": { "type": "string" }
    },
    "required": [
      "sensorId",
      "kickStrength",
      "maxImpulse",
      "tangentialStrength",
      "maxTangentialImpulse",
      "spinTransfer",
      "spinRadius",
      "maxAngularSpeed",
      "cooldownSeconds",
      "resetSeconds",
      "centre",
      "homeGoalTag",
      "awayGoalTag"
    ],
    "additionalProperties": false
  }
}
